# ================================================================
# MockPilot AI — .gitignore
# ================================================================


# ── Secrets & Environment ────────────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets.toml


# ── Database ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3


# ── Uploads & Generated Reports ──────────────────────────────────
uploads/
reports/


# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/


# ── Virtual Environments ─────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/
virtualenv/


# ── Jupyter Notebooks ────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb


# ── AI / ML Artifacts ────────────────────────────────────────────
# Whisper model cache
~/.cache/whisper/
*.pt
*.pth
*.bin
*.onnx


# ── Streamlit ────────────────────────────────────────────────────
.streamlit/
!.streamlit/config.toml


# ── Testing ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.cover
.tox/
nosetests.xml
coverage.xml


# ── Linting / Type Checking ──────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/


# ── IDEs & Editors ───────────────────────────────────────────────
# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*


# ── OS Files ─────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/


# ── Temporary Files ──────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
